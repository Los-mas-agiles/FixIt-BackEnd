# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube a git.

# --- Base de datos (Supabase → Connect → ORM → Prisma) ---
# Transaction pooler (puerto 6543): lo usa la API
DATABASE_URL=
# Session pooler (puerto 5432): solo para migraciones y seed
DIRECT_URL=

# --- Supabase Storage (Project Settings → API Keys) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=fotos

# --- Auth ---
# Cadena larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- IA ---
# Google AI Studio → Get API key
GEMINI_API_KEY=
# console.groq.com → API Keys
GROQ_API_KEY=
# Modelos que se prueban EN ORDEN (proveedor:modelo). Se saltan los proveedores sin API key.
IA_MODELOS=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite

# --- Web Push (generar con: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@fixit.demo

# --- Reglas y servidor ---
WIP_LIMITE_TECNICO=3
# Webs que pueden llamar a la API. "*" = comodín (sirve para los previews de Vercel)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://fix-it-front-end*.vercel.app
PORT=3000
